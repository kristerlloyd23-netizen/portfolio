# Public canonical URL. Replace with the real deployment origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production contact persistence.
CONTACT_STORAGE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional abuse-control tuning.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Local development only: uses a gitignored JSONL file instead of PostgreSQL.
# CONTACT_STORAGE=file
# CONTACT_DATA_DIR=.data
